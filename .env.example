# ==============================================================================
# FrameFlow Production Environment Configuration
# Copy this file to .env on your VPS / server: cp .env.example .env
# ==============================================================================

# Domain for SSL (Leave as localhost for IP-only testing, or enter your domain, e.g., photos.yourstudio.com)
DOMAIN=localhost

# Web Port (Used when running without Caddy; default: 80)
WEB_PORT=80

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password_in_production
POSTGRES_DB=frameflow

# JWT Authentication Secret (Generate a strong random string: openssl rand -base64 32)
JWT_SECRET=replace_with_a_super_secret_jwt_random_key_2026

# ==============================================================================
# Object Storage Driver: 's3' (AWS S3), 'r2' (Cloudflare R2), or 'local'
# ==============================================================================
# Start with 's3' to learn AWS S3, or 'local' for zero-cloud testing on VPS disk.
# Switch to 'r2' anytime with zero code changes!
STORAGE_DRIVER=s3

# ------------------------------------------------------------------------------
# 1. AWS S3 Configuration (Used if STORAGE_DRIVER=s3)
# ------------------------------------------------------------------------------
# AWS Region (e.g., ap-south-1 for Mumbai, ideal for Indian clients)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_BUCKET_NAME=frameflow-events-2026
# Optional CloudFront CDN or custom domain (e.g., https://d111111abcdef8.cloudfront.net)
AWS_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Configuration (Used if STORAGE_DRIVER=r2)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=frameflow-prod
R2_PUBLIC_DOMAIN=https://media.yourstudio.com
