# ==============================================================================
# FrameFlow Production Environment Configuration
# Copy this file to .env on your VPS / server: cp .env.example .env
# ==============================================================================

# Domain for SSL (Leave as localhost for IP-only testing, or enter your domain, e.g., photos.yourstudio.com)
DOMAIN=localhost

# Web Port (Used when running without Caddy; default: 80)
WEB_PORT=80

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password_in_production
POSTGRES_DB=frameflow

# JWT Authentication Secret (Generate a strong random string: openssl rand -base64 32)
JWT_SECRET=replace_with_a_super_secret_jwt_random_key_2026

# ==============================================================================
# Object Storage (Cloudflare R2 or Local Storage)
# ==============================================================================
# Set to 'local' to store files inside the docker volume with zero external setup,
# or 'r2' for Cloudflare R2 zero-egress production object storage.
STORAGE_DRIVER=local

# Cloudflare R2 Credentials (Required only if STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=frameflow-prod
R2_PUBLIC_DOMAIN=https://media.yourstudio.com
