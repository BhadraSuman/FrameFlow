{
  "name": "@frameflow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "prisma:push": "prisma db push",
    "prisma:push:pg": "prisma db push --schema=prisma/schema.postgresql.prisma --accept-data-loss"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}
