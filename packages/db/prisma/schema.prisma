datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  passwordHash      String
  fullName          String
  studioName        String
  phone             String?
  role              String      @default("STUDIO_OWNER")
  isActive          Boolean     @default(true)
  storageUsedBytes  BigInt      @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  events            Event[]

  @@map("users")
}

model Event {
  id                  String        @id @default(uuid())
  userId              String
  title               String
  slug                String        @unique
  eventType           String
  eventDate           DateTime
  clientName          String
  clientEmail         String
  clientPhone         String?

  pinHash             String
  pinSalt             String
  coverMediaId        String?
  status              String        @default("DRAFT")

  photoCount          Int           @default(0)
  totalBytes          BigInt        @default(0)

  expiresAt           DateTime
  gracePeriodEndsAt   DateTime
  purgedAt            DateTime?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItems          MediaItem[]
  selectionRounds     SelectionRound[]
  clientSessions      ClientSession[]
  exportJobs          ExportJob[]

  @@index([userId])
  @@index([slug])
  @@map("events")
}

model MediaItem {
  id                String       @id @default(uuid())
  eventId           String
  originalFilename  String

  originalKey       String
  previewKey        String?
  thumbnailKey      String?

  mimeType          String
  fileSizeBytes     BigInt
  width             Int?
  height            Int?

  status            String       @default("PENDING_UPLOAD")
  checksumSha256    String?
  sortOrder         Int          @default(0)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections        Selection[]

  @@index([eventId])
  @@index([eventId, status])
  @@map("media_items")
}

model SelectionRound {
  id             String        @id @default(uuid())
  eventId        String
  roundNumber    Int           @default(1)
  status         String        @default("OPEN")
  maxSelections  Int?
  clientNotes    String?
  submittedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections     Selection[]
  exportJobs     ExportJob[]

  @@unique([eventId, roundNumber])
  @@map("selection_rounds")
}

model Selection {
  id             String         @id @default(uuid())
  roundId        String
  mediaItemId    String
  clientComment  String?
  selectedAt     DateTime       @default(now())

  round          SelectionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  mediaItem      MediaItem      @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([roundId, mediaItemId])
  @@map("selections")
}

model ClientSession {
  id                String       @id @default(uuid())
  eventId           String
  sessionTokenHash  String       @unique
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  createdAt         DateTime     @default(now())

  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([sessionTokenHash])
  @@map("client_sessions")
}

model ExportJob {
  id             String         @id @default(uuid())
  eventId        String
  roundId        String
  exportType     String         @default("ZIP_ORIGINALS")
  status         String         @default("PENDING")
  outputKey      String?
  fileSizeBytes  BigInt?
  errorMessage   String?
  downloadUrl    String?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round          SelectionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("export_jobs")
}
