FROM node:22-bookworm-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.29.3 --activate
WORKDIR /app

# Install native tools if needed
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy root & workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY apps/image-worker/package.json ./apps/image-worker/

# Install dependencies for workspace
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY apps/image-worker ./apps/image-worker

# Use production PostgreSQL schema and build
RUN cp packages/db/prisma/schema.postgresql.prisma packages/db/prisma/schema.prisma && \
    pnpm --filter @frameflow/db run prisma:generate && \
    pnpm --filter @frameflow/shared run build && \
    pnpm --filter @frameflow/db run build && \
    pnpm --filter @frameflow/image-worker run build

EXPOSE 4001
CMD ["node", "apps/image-worker/dist/index.js"]
