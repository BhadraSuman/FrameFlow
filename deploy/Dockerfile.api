FROM node:22-bookworm-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.29.3 --activate
WORKDIR /app

# Copy root & workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY apps/api/package.json ./apps/api/

# Install dependencies for workspace
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY apps/api ./apps/api
COPY deploy/entrypoint-api.sh ./deploy/entrypoint-api.sh

# Use production PostgreSQL schema and build
RUN cp packages/db/prisma/schema.postgresql.prisma packages/db/prisma/schema.prisma && \
    pnpm --filter @frameflow/db run prisma:generate && \
    pnpm --filter @frameflow/shared run build && \
    pnpm --filter @frameflow/db run build && \
    pnpm --filter @frameflow/api run build && \
    chmod +x ./deploy/entrypoint-api.sh

EXPOSE 4000
ENTRYPOINT ["./deploy/entrypoint-api.sh"]
